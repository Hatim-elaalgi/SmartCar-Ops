# Copy to .env and adjust. Every value is optional.

# Host port of the dashboard (http://localhost:8050)
PORT=8050

# 1 = auto-reload on code changes + Dash dev tools
DEBUG=0

# Timezone used for absolute times (e.g. Europe/Paris, Africa/Casablanca, Africa/Tunis)
TZ=UTC

# --- ESP32-CAM -------------------------------------------------------------
# The container cannot see your Wi-Fi's mDNS, so it finds the camera by scanning
# these subnets. Put YOUR network first (run `ipconfig` on the laptop: if your IPv4
# is 192.168.1.23, use 192.168.1.0/24). Defaults cover home routers + phone/PC hotspots.
CAMERA_SCAN_SUBNETS=192.168.1.0/24,192.168.0.0/24,192.168.43.0/24,192.168.137.0/24,172.20.10.0/28,10.0.0.0/24
# Skip discovery and use a fixed IP (you can also type it on the Camera page)
CAMERA_IP=
# Stream URL of your firmware ({ip} is replaced). CameraWebServer default:
CAMERA_STREAM_URL=http://{ip}:81/stream
# Camera mounted on its side: turn the image upright, clockwise (0, 90, 180, 270 — also on the Camera page)
CAMERA_ROTATE=90

# Show a simulated toy car on the Prototype pages while the camera is offline
PROTO_DEMO_WHEN_OFFLINE=1
# Toy car speed on straight tape (cm/s) with MOTOR_SPEED = 190 in firmware/arduino_car/arduino_car.ino.
# 30 is an estimate: time the car over 1 m of straight tape and put the real value here.
PROTO_SPEED_CM_S=30

# --- Models ----------------------------------------------------------------
# none | auto | profile:models/real_road.json | onnx:models/x.onnx | yolo:models/x.pt | python:<module>:<Class> | esp32
DETECTOR_PROTO=auto
# auto = the 2 models produced by training/train_road_obstacles.ipynb (road users + road hazards)
DETECTOR_REAL=auto

# --- Real-world dashcam ----------------------------------------------------
# Video analysed live by the trained models (Camera page, Real-world mode). It is the camera of CAR-01.
#   demo/videos                  real dashcam clips cut by the training notebook (played in a loop)
#   http://<phone-ip>:8080/video a phone with the free "IP Webcam" app, fixed on a real car's dashboard
#   esp32                        the prototype's ESP32-CAM
REAL_VIDEO_SOURCE=demo/videos
# Distance estimate (flat road): horizon line (fraction of image height), camera height (m), lens angle (deg)
DASHCAM_HORIZON=0.5
DASHCAM_HEIGHT_M=1.3
DASHCAM_HFOV_DEG=90

# Jupyter token for the training container (http://localhost:8888)
JUPYTER_TOKEN=smartcar
# Folder (inside the project) of real road images fed to DETECTOR_REAL by the simulator
REAL_IMAGES_DIR=

# Build the image with YOLO/torch support (large download)
WITH_YOLO=0

# Number of simulated cars in Real-world mode
REAL_FLEET_SIZE=3
